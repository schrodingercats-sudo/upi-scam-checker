# Google Gemini API Key for UPI Scam Detection
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here

# Google Safe Browsing API Key
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# Node Environment
NODE_ENV=production

# OpenRouter API Key for DeepSeek
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Bland AI Configuration for Call Analysis
BLAND_API_URL=https://api.bland.ai/v1/calls
BLAND_API_KEY=your_bland_api_key_here

# Backend URL for production (will be set after Render deployment)
NEXT_PUBLIC_BACKEND_URL=https://your-render-backend-url.onrender.com